<div class="bg-gray-950">
  <div id="rankings" class="common-width bg-gray-950 border-y-2 border-y-gray-950 divide-y-2 divide-gray-950">
    <h2 class="text-4xl mb-8 mt-8 font-serif text-center text-slate-50">Rankings</h2>
    <div class="flex flex-row">
      <div class="ranking-tier-label bg-rose-400">
        S
      </div>
      <div class="ranking-tier-sort">
        <% blog.articles.select { |a| a.data.ranking == "S" }.each do |article| %>
          <% link_to(article) do %>
            <%= image_tag image_variant(article.data.cover_image.to_s, :thumb),
                          class: "ranking-tier-image",
                          alt: article.data.title %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="flex flex-row">
